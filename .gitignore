# Allowlist: ignore everything at the top level, then re-include what the
# package ships or needs to build and test. A new top-level file or directory
# stays untracked until it is added here on purpose.
/*
!/R/
!/tests/
!/man/
!/inst/
!/.github/
!/DESCRIPTION
!/NAMESPACE
!/NEWS.md
!/README.md
!/LICENSE
!/LICENSE.md
!/.Rbuildignore
!/.gitignore
!/horizons.Rproj
!/CITATION.cff
!/CONTRIBUTING.md

# Inside the allowed directories: local and generated files
.DS_Store
.Rhistory
.RData
.RDataTmp*
.Rproj.user/
*.qs
*.qs2
*.rds
*.tmp
tests/testthat/_problems/
tests/testthat/output/

# Committed test fixtures are tracked
!tests/testthat/fixtures/*.rds
